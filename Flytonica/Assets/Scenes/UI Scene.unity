  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u043D\u043E \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0432
    \u0441\u0435\u0431\u044F \u0434\u0432\u0430\_\u0432\u0430\u0436\u043D\u044B\u0445
    \u0434\u043B\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438\_\u0430\u0441\u043F\u0435\u043A\u0442\u0430:
    \u0440\u0430\u0441\u0447\u0435\u0442 \u0440\u0430\u0441\u0445\u043E\u0434\u0430
    \u0442\u043E\u043F\u043B\u0438\u0432\u0430, \u0447\u0442\u043E\u0431\u044B \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C,
    \u0447\u0442\u043E \u0441\u0430\u043C\u043E\u043B\u0435\u0442 \u0441\u043C\u043E\u0436\u0435\u0442
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E \u0434\u043E\u043B\u0435\u0442\u0435\u0442\u044C
    \u0434\u043E \u043F\u0443\u043D\u043A\u0442\u0430 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F,
    \u0438 \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0439\_\u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u044B\u043C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C,
    \u0447\u0442\u043E\u0431\u044B \u0441\u0432\u0435\u0441\u0442\u0438 \u043A \u043C\u0438\u043D\u0438\u043C\u0443\u043C\u0443
    \u0440\u0438\u0441\u043A \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F
    \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435"
