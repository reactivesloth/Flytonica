--- !u!114 &6379868462922713465
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5773099636651715727}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 24b08bd22ac2436da6c52fe05accd004, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  wayPoints:
  - {fileID: 2444989565677839455}
  - {fileID: 2253680580214585070}
  - {fileID: 4609785613798327541}
  - {fileID: 4850920306361525453}
  currentMaterial: {fileID: 2100000, guid: 448cc65a0c42225458ecbeefe87757e8, type: 2}
  nextMaterial: {fileID: 2100000, guid: 619429c61601d93469aa44bae9ec1080, type: 2}
  defaultMaterial: {fileID: 2100000, guid: f4e207d39541bad4fafa095da2823b45, type: 2}
  welcomeText:
    text: "\u0412 \u044D\u0442\u043E\u043C \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0438
      \u0432\u0430\u043C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043F\u0440\u043E\u0441\u0442\u044B\u0435 \u0444\u0438\u0433\u0443\u0440\u044B
      \u043F\u0438\u043B\u043E\u0442\u0430\u0436\u0430. \u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
      \u043F\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u044B\u043C
      \u0442\u043E\u0447\u043A\u0430\u043C \u0438 \u043D\u0435 \u043E\u0442\u0434\u0430\u043B\u044F\u0439\u0442\u0435\u0441\u044C
      \u043E\u0442 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.
      \u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0447\u0435\u043A\u043F\u043E\u0438\u043D\u0442\u0430
      \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0440\u044B\u0441\u043A\u0430\u043D\u044C\u0435."
    clip: {fileID: 8300000, guid: 9a09f24958be0a9488ce08e9f3ace9fe, type: 3}
  resetText:
    text: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u043B\u0435\u043A\u043E
      \u043E\u0442 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0435
      \u0440\u0430\u0437"
    clip: {fileID: 8300000, guid: 16724d8ba4d9ac947bc92d6e014c5be3, type: 3}
  finishText:
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u043F\u0438\u043B\u043E\u0442\u0430\u0436!
      \u0421\u0446\u0435\u043D\u0430\u0440\u0438\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D.
      \u041F\u043E\u0441\u0430\u0434\u0438\u0442\u0435 \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E \u0438 \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435
      \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438. "
    clip: {fileID: 8300000, guid: ea8ce26804008ee4c8f55933fe7ef642, type: 3}
  maxDeviationDistance: 0.5
  cameraViewMode: 1
  targetObject: {fileID: 0}
  acceptableRotationError: 10
