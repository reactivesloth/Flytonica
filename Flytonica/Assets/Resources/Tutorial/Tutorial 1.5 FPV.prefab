--- !u!114 &-9070494670248271593
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5773099636651715727}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b66679ed4f5c430198fe04828ae4e0b1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  welcomeText:
    text: "\u0412 \u044D\u0442\u043E\u043C \u0441\u0446\u0435\u043D\u0430\u0440\u0438\u0438
      \u0432\u044B \u043D\u0430\u0443\u0447\u0438\u0442\u0435\u0441\u044C \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u044C
      \u0440\u0435\u0436\u0438\u043C \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430
      \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043B\u0438\u0446\u0430
      \u0441 \u043A\u0430\u043C\u0435\u0440\u044B \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440\u0430
      \u0438 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440\u043E\u043C
      \u0432 \u0442\u0430\u043A\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435."
    clip: {fileID: 8300000, guid: 54b09a2820a153544aa8510c6b6f1233, type: 3}
  fpvHintText:
    text: "\u0412 \u0440\u0435\u0436\u0438\u043C\u0435 FPV \u0432\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0435
      \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440\u043E\u043C
      \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043B\u0438\u0446\u0430,
      \u0438 \u0432\u0438\u0434\u0438\u0442\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0438\u043D\u0442\u0435\u0440\u0444\u0435\u0439\u0441, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F \u0440\u0435\u0436\u0438\u043C
      \u043F\u043E\u043B\u0435\u0442\u0430, \u0443\u0440\u043E\u0432\u0435\u043D\u044C
      \u0437\u0430\u0440\u044F\u0434\u0430 \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0430,
      \u043A\u043E\u043C\u043F\u0430\u0441, \u0432\u044B\u0441\u043E\u0442\u0430,
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C, \u0430\u0432\u0438\u0430\u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442,
      \u0430 \u0442\u0430\u043A \u0436\u0435 \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438"
    clip: {fileID: 8300000, guid: 4373a12b707fc0940a0c7a40e1736641, type: 3}
  engineInit:
    text: "\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438
      \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440\u0430."
    clip: {fileID: 8300000, guid: c7122cfb872a52540b40ed9e4ab52a49, type: 3}
  changeToFPV:
    text: "\u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0430
      \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u0435 FPV \u0440\u0435\u0436\u0438\u043C,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043A\u0430\u043C\u0435\u0440\u0443 \u0434\u0440\u043E\u043D\u0430."
    clip: {fileID: 8300000, guid: d6a3db2ab30bfcb4cb3f153d5e508d0c, type: 3}
  takeOff:
    text: "\u041F\u043B\u0430\u0432\u043D\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0443 \u0432 3 \u043C\u0435\u0442\u0440\u0430
      \u043D\u0430\u0434 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E
      \u0437\u0435\u043C\u043B\u0438."
    clip: {fileID: 8300000, guid: f2da42c3835962445ab48df52f9acb63, type: 3}
  holdHeight:
    text: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435\u0441\u044C \u0434\u043E
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0438
      \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C
      \u0432 \u043D\u0435\u0439 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 5 \u0441\u0435\u043A\u0443\u043D\u0434.
      \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043E\u0431\u0430
      \u0441\u0442\u0438\u043A\u0430 \u0434\u043B\u044F \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u043A\u0438
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F. \u041D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0435\u0441\u044C
      \u0438 \u043D\u0435 \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0439\u0442\u0435
      \u0440\u0435\u0437\u043A\u0438\u0445 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0439."
    clip: {fileID: 8300000, guid: 03aaa97db4ed07043bb8cfdad1e63259, type: 3}
  landing:
    text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435
      \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u0432\u043D\u0438\u0437
      \u0438 \u043F\u043E\u0441\u0430\u0434\u0438\u0442\u0435 \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E."
    clip: {fileID: 8300000, guid: 42ce5c7fd359d2b45be8f3e110c0cb7a, type: 3}
  engineOff:
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430!
      \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440."
    clip: {fileID: 8300000, guid: 860bd1fcd4582544588a2d7c878137ca, type: 3}
  mistakeReturn:
    text: "\u0412\u044B \u043D\u0435 \u0441\u043C\u043E\u0433\u043B\u0438 \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u0432\u044B\u0441\u043E\u0442\u0443, \u044D\u0442\u0430\u043F \u0437\u0430\u0434\u0430\u043D\u0438\u044F
      \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u0437\u0430\u043D\u043E\u0432\u043E."
    clip: {fileID: 8300000, guid: 45b5cadcb8788b54291973d157f8d284, type: 3}
  checkpointHoldHeightName: GATE_ PLSTC_Hex(Clone)
