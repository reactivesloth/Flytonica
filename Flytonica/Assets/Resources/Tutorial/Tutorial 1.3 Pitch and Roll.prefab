--- !u!114 &-9032473218899658211
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5773099636651715727}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3db1dd02316446e1aaf2b514f22c1503, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  welcomeText:
    text: "\u0412 \u044D\u0442\u043E\u043C \u0437\u0430\u0434\u0430\u043D\u0438\u0438
      \u0432\u044B \u043E\u0441\u0432\u043E\u0438\u0442\u0435 \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B
      \u0441\u0442\u0438\u043A\u0430 \u0442\u0430\u043D\u0433\u0430\u0436\u0430 \u0438
      \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0440\u0430\u0437\u043D\u044B\u0445 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F\u0445,
      \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044F
      \u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u044E \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440\u0430."
    clip: {fileID: 8300000, guid: 6ae4a201c2d7524488d09176a2c02885, type: 3}
  engineInit:
    text: "\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438
      \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440\u0430."
    clip: {fileID: 8300000, guid: 7a7dbb29df5e70847984bc48288a877c, type: 3}
  takeOff:
    text: "\u041F\u043B\u0430\u0432\u043D\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0443 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435
      1 \u043C\u0435\u0442\u0440\u0430 \u043D\u0430\u0434 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E
      \u0437\u0435\u043C\u043B\u0438."
    clip: {fileID: 8300000, guid: a37eb3d69c9ff0341b6a64c63a00d144, type: 3}
  moveForward:
    text: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A \u0432\u0432\u0435\u0440\u0445, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u0447\u0430\u0442\u044C \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      \u0432\u043F\u0435\u0440\u0435\u0434."
    clip: {fileID: 8300000, guid: 9609a46bc18250a4395df7500bf4bb33, type: 3}
  moveBackward:
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0427\u0442\u043E\u0431\u044B
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u043D\u0430\u0437\u0430\u0434
      \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A \u0432\u043D\u0438\u0437."
    clip: {fileID: 8300000, guid: 6b227e55e570718459b8d1ec8a5035ac, type: 3}
  moveLeft:
    text: "\u041E\u0442\u043A\u043B\u043E\u043D\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A \u0432\u043B\u0435\u0432\u043E \u0434\u043B\u044F
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440
      \u0434\u0432\u0438\u0433\u0430\u043B\u0441\u044F \u0432 \u043B\u0435\u0432\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
    clip: {fileID: 8300000, guid: 3a809aa899796d84a9a5513d9dc7bf62, type: 3}
  moveRight:
    text: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B
      \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440 \u043B\u0435\u0442\u0435\u043B
      \u0432 \u043F\u0440\u0430\u0432\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043E\u0442\u043A\u043B\u043E\u043D\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A \u0432\u043F\u0440\u0430\u0432\u043E."
    clip: {fileID: 8300000, guid: dce7ea89903ab0948862d17017d9ea2d, type: 3}
  landing:
    text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043B\u0430\u0432\u043D\u043E
      \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043B\u0435\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A \u0432\u043D\u0438\u0437 \u0438 \u043F\u043E\u0441\u0430\u0434\u0438\u0442\u0435
      \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440 \u043D\u0430
      \u0437\u0435\u043C\u043B\u044E."
    clip: {fileID: 8300000, guid: ce893d52d8c7e8c49a255f27e87b9019, type: 3}
  engineOff:
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430!
      \u041E\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043B\u0435\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A \u0432\u043D\u0438\u0437 \u0438 \u0437\u0430\u0436\u043C\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440."
    clip: {fileID: 8300000, guid: 26f3b37c88293ac44a66b88502156ef2, type: 3}
