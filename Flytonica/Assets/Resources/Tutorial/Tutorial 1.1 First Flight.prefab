--- !u!114 &7470060875648318188
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5773099636651715727}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a926ee3e744344e1ba08457ae970c0a3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  welcomeText:
    text: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u043C \u0432\u0430\u0448 \u043F\u0435\u0440\u0432\u044B\u0439
      \u043F\u043E\u043B\u0435\u0442 \u043D\u0430 \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440\u0435
      \u0432 VR-\u0441\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0435 flytonica. "
    clip: {fileID: 8300000, guid: ef6b9a28e2bd349bdb36bca7fdd4fdee, type: 3}
  engineInit:
    text: "\u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u043C
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438. \u0414\u043B\u044F
      \u044D\u0442\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u0435
      \u043E\u0431\u0430 \u0441\u0442\u0438\u043A\u0430 \u0432\u043D\u0438\u0437
      \u0434\u043E \u0443\u043F\u043E\u0440\u0430, \u0430 \u043F\u043E\u0441\u043B\u0435
      - \u0432\u043D\u0443\u0442\u0440\u044C."
    clip: {fileID: 8300000, guid: 72c56653c86dd4e27be335d9f049931c, type: 3}
  takeOff:
    text: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440
      \u0432 \u0432\u043E\u0437\u0434\u0443\u0445, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043F\u043B\u0430\u0432\u043D\u043E \u043F\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044C
      \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u0432\u0432\u0435\u0440\u0445."
    clip: {fileID: 8300000, guid: 341502b45d4f94537869fe0c8f5f355e, type: 3}
  rotatingAround:
    text: "\u041F\u043E\u0434\u0432\u0438\u043D\u044C\u0442\u0435 \u043B\u0435\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A \u0432\u043F\u0440\u0430\u0432\u043E \u0438\u043B\u0438
      \u0432\u043B\u0435\u0432\u043E, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440."
    clip: {fileID: 8300000, guid: 6a03a448680dd4c1fb7f4b7d518b3b96, type: 3}
  landing:
    text: "\u041F\u043B\u0430\u0432\u043D\u043E \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435
      \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u0432\u043D\u0438\u0437,
      \u0438 \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440
      \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
      \u0437\u0435\u043C\u043B\u0438."
    clip: {fileID: 8300000, guid: 676f830e850f5488c9659786c65ba0ae, type: 3}
  engineOff:
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430!
      \u0421\u043D\u043E\u0432\u0430 \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435
      \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u0432\u043D\u0438\u0437
      \u0434\u043E \u0443\u043F\u043E\u0440\u0430 \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435
      \u0435\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438."
    clip: {fileID: 8300000, guid: 81368397598664e7a9b9ee897072850d, type: 3}
