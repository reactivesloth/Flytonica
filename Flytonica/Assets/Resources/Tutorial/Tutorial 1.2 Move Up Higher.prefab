--- !u!114 &-8012527277309174980
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5773099636651715727}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ca4a878fea84b63a65a46b6fe92dbd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  welcomeText:
    text: "\u0412 \u044D\u0442\u043E\u043C \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u0438
      \u0432\u044B \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0435\u0442\u0435 \u043F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F
      \u0432\u044B\u0448\u0435."
    clip: {fileID: 0}
  engineInit:
    text: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440
      \u0438 \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438.
      \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u0435
      \u043E\u0431\u0430 \u0441\u0442\u0438\u043A\u0430 \u0432\u043D\u0438\u0437
      \u0434\u043E \u0443\u043F\u043E\u0440\u0430, \u0430 \u043F\u043E\u0441\u043B\u0435
      - \u0432\u043D\u0443\u0442\u0440\u044C."
    clip: {fileID: 0}
  takeOff2m:
    text: "\u041F\u043B\u0430\u0432\u043D\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0443 \u043E\u0442 1 \u0434\u043E
      2 \u043C\u0435\u0442\u0440\u043E\u0432. \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435
      \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0432\u0432\u0435\u0440\u0445."
    clip: {fileID: 0}
  notRushingRecommendation:
    text: "\u041D\u0435 \u0441\u043F\u0435\u0448\u0438\u0442\u0435: \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0439\u0442\u0435
      \u0432\u0441\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043F\u043B\u0430\u0432\u043D\u043E
      \u0438 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E."
    clip: {fileID: 0}
  takeOff5m:
    text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0443 \u0432\u044B\u0448\u0435
      5 \u043C\u0435\u0442\u0440\u043E\u0432 \u043D\u0430\u0434 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E
      \u0437\u0435\u043C\u043B\u0438."
    clip: {fileID: 0}
  windRecommendation:
    text: "\u041E\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435,
      \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0445 \u043B\u043E\u043A\u0430\u0446\u0438\u044F\u0445
      \u043D\u0430 \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440
      \u0432\u043B\u0438\u044F\u0435\u0442 \u0441\u0438\u043B\u0430 \u0432\u0435\u0442\u0440\u0430.
      \u041E\u0431\u044B\u0447\u043D\u043E \u0447\u0435\u043C \u0432\u044B\u0448\u0435
      - \u0442\u0435\u043C \u0432\u0435\u0442\u0435\u0440 \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
    clip: {fileID: 0}
  landing:
    text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043B\u0430\u0432\u043D\u043E
      \u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043B\u0435\u0432\u044B\u0439
      \u0441\u0442\u0438\u043A \u0432\u043D\u0438\u0437 \u0438 \u043F\u043E\u0441\u0430\u0434\u0438\u0442\u0435
      \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440 \u043D\u0430
      \u0437\u0435\u043C\u043B\u044E."
    clip: {fileID: 0}
  engineOff:
    text: "\u041E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430!
      \u041D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u043E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u043A\u0432\u0430\u0434\u0440\u043E\u043A\u043E\u043F\u0442\u0435\u0440."
    clip: {fileID: 0}
